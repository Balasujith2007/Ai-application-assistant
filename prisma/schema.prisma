/// Super-Admin-editable badge catalog. Seeded from the code catalog
/// (`lib/gamification/badgeConfig.ts`) and override-safe: `evaluate()` stays in
/// code, keyed by `badgeId`, while threshold/metadata overrides live here.
model BadgeCatalog {
  badgeId     String   @id
  title       String
  category    String
  tier        String   @default("BRONZE")
  description String
  criteria    String
  icon        String
  unit        String   @default("")
  threshold   Float
  xpReward    Int      @default(0)
  rarity      String   @default("COMMON")
  awardSource String   @default("ENGINE") // ENGINE | MONTHLY
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  artworkKey  String?
  monthlyRule Json?
  // ── Phase 2 streak-badge policy (additive, Super-Admin owned) ──
  /// High-value streak badges may only be awarded when ownership is proven.
  requireOwnershipVerification Boolean @default(false)
  /// JSON array of platform ids allowed to back this badge; null = any supported.
  eligibleProviders            Json?
  /// NONE | VERIFIED_ACCEPTED_SUBMISSION
  evidenceRequirement          String  @default("NONE")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, active])
  @@map("badge_catalog")
}

/// Immutable monthly career-performance snapshot (frozen at month end).
/// Mirrors `WeeklyPerformanceSnapshot` but never overwrites weekly data.
model MonthlyPerformanceSnapshot {
  id              String   @id @default(cuid())
  studentId       String
  monthKey        String // YYYY-MM (Asia/Kolkata)
  startDate       DateTime
  endDate         DateTime
  weightedScore   Float    @default(0.0)
  careerBreakdown Json?
  weeksActive     Int      @default(0)
  rank            Int?
  createdAt       DateTime @default(now())

  @@unique([studentId, monthKey], name: "MonthlyPerformanceSnapshot_studentId_monthKey_unique")
  @@index([monthKey, weightedScore])
  @@index([studentId, monthKey])
  @@map("monthly_performance_snapshots")
}

/// Idempotency ledger for the monthly recognition run (one row per month).
model MonthlyRecognitionRun {
  id               String    @id @default(cuid())
  monthKey         String    @unique
  evaluationStart  DateTime
  evaluationEnd    DateTime
  totalStudents    Int       @default(0)
  championsAwarded Int       @default(0)
  badgesAwarded    Int       @default(0)
  failedCount      Int       @default(0)
  status           String    @default("PENDING") // PENDING | COMPLETED | FAILED
  resultSummary    Json?
  startedAt        DateTime?
  completedAt      DateTime?
  errorLog         Json?
  createdAt        DateTime  @default(now())

  @@index([status])
  @@map("monthly_recognition_runs")
}

/// Audit trail for every badge grant / revocation (engine, monthly or manual).
model BadgeAwardAudit {
  id        String   @id @default(cuid())
  studentId String
  badgeId   String
  action    String // GRANT | REVOKE
  source    String   @default("ENGINE") // ENGINE | MONTHLY | MANUAL
  reason    String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([badgeId, createdAt])
  @@map("badge_award_audits")
}

