// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  MENTOR
  FACULTY
  HOD
  PLACEMENT_CELL
  ADMIN
  SUPER_ADMIN
}

enum ApplicationType {
  INTERNSHIP
  JOB
  HACKATHON
  COMPETITION
  WORKSHOP
  SCHOLARSHIP
  OTHER
}

enum ApplicationStatus {
  SAVED
  INITIATED
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum OpportunityType {
  JOB
  FULL_TIME
  INTERNSHIP
  HACKATHON
  COMPETITION
  SCHOLARSHIP
  WORKSHOP
  OTHER
}

enum OpportunityMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum OpportunityRegistrationStatus {
  STARTED
  INITIATED
  IN_PROGRESS
  STUDENT_CONFIRMED
  VERIFIED
  REGISTERED
  ONGOING
  COMPLETED
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
  FAILED
  CANCELLED
}

// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role     @default(STUDENT)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notificationPreferences Json?
  privacySettings Json?
  aiPreferences Json?

  profile              Profile?
  verifiedProfiles     VerifiedProfile[]
  resumes              Resume[]
  applications         Application[]
  tasks                Task[]
  interviews           Interview[]
  activities           Activity[]
  notifications        Notification[] @relation("UserNotifications")
  sentNotifications    Notification[] @relation("SentNotifications")
  postedOpportunities  Opportunity[]  @relation("PostedOpportunities")
  registrations        OpportunityRegistration[]
  autofillSessions     AutofillSession[]
  customProfileFields  CustomProfileField[]
  applicationDrafts    ApplicationDraftAnswer[]
  extensionAuthCodes   ExtensionAuthCode[]
  autofillAuditEvents  AutofillAuditEvent[]
  createdForms         Form[]                 @relation("FormCreator")
  formResponses        FormResponse[]
  auditLogs            AuditLog[]

  // Mentor-Student relationship
  mentorId      String?
  mentor        User?   @relation("StudentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students      User[]  @relation("StudentMentor")

  @@map("users")
}

// ============================================================
// VERIFIED PROFILE
// ============================================================

model VerifiedProfile {
  id                 String   @id @default(cuid())
  studentId          String
  platform           String   // GITHUB, LINKEDIN, CODOLIO
  profileUrl         String
  username           String?
  verificationStatus String   @default("UNVERIFIED") // VERIFIED, FORMAT_VERIFIED, UNVERIFIED, FAILED
  verifiedAt         DateTime @default(now())
  publicMetadata     Json?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@map("verified_profiles")
}

// ============================================================
// PROFILE
// ============================================================

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  department       String?
  year             Int?
  section          String?
  college          String?
  location         String?
  careerObjective  String?
  linkedinUrl      String?
  githubUrl        String?
  portfolioUrl     String?
  codolioUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  careerPreferences Json?
  employeeId       String?
  registerNo       String?  @unique

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  education   Education[]
  projects    Project[]
  experiences Experience[]
  skills      ProfileSkill[]

  @@map("profiles")
}

// ============================================================
// SKILL (many-to-many via ProfileSkill)
// ============================================================

model Skill {
  id       String         @id @default(cuid())
  name     String         @unique
  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  skillId   String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

// ============================================================
// EDUCATION
// ============================================================

model Education {
  id           String  @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("education")
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id           String    @id @default(cuid())
  profileId    String
  title        String
  description  String?
  technologies String[]
  githubUrl    String?
  liveUrl      String?
  startDate    DateTime?
  endDate      DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ============================================================
// EXPERIENCE
// ============================================================

model Experience {
  id               String    @id @default(cuid())
  profileId        String
  company          String
  role             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

// ============================================================
// RESUME
// ============================================================

model Resume {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  fileUrl      String
  originalName String
  mimeType     String?
  fileSize     Int?
  isActive     Boolean  @default(true)
  uploadedAt   DateTime @default(now())

  // Mentor review fields
  reviewStatus   String?   @default("PENDING_REVIEW") // PENDING_REVIEW, REVIEWED, CHANGES_REQUESTED
  reviewFeedback String?
  reviewedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

// ============================================================
// APPLICATION
// ============================================================

model Application {
  id              String            @id @default(cuid())
  userId          String
  opportunityId   String?
  companyName     String
  position        String
  applicationType ApplicationType   @default(INTERNSHIP)
  applicationUrl  String?
  location        String?
  salary          String?
  description     String?
  nextAction      String?
  resumeVersion   String?
  status          ApplicationStatus @default(SAVED)
  appliedDate     DateTime?
  deadline        DateTime?
  notes           String?
  githubUrl       String?
  codolioUrl      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@map("applications")
}

// ============================================================
// TASK
// ============================================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskCategory {
  APPLICATION
  PREPARATION
  FOLLOW_UP
  OTHER
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  category    TaskCategory @default(OTHER)
  priority    TaskPriority @default(MEDIUM)
  isCompleted Boolean      @default(false)
  deadline    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// ============================================================
// INTERVIEW
// ============================================================

enum InterviewType {
  TECHNICAL
  HR
  MANAGER
  ONLINE_ASSESSMENT
  OTHER
}

model Interview {
  id          String        @id @default(cuid())
  userId      String
  companyName String
  role        String
  type        InterviewType @default(TECHNICAL)
  date        DateTime
  time        String?
  location    String?
  prepTopics  String[]
  feedback    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

// ============================================================
// OPPORTUNITY
// ============================================================

model Opportunity {
  id                  String            @id @default(cuid())
  title               String
  organization        String
  companyName         String?
  role                String?
  type                OpportunityType   @default(JOB)
  description         String
  opportunityUrl      String?
  registrationUrl     String?
  applyUrl            String?
  location            String?
  mode                OpportunityMode   @default(ONLINE)
  salary              String?
  stipend             String?
  prize               String?
  openings            Int?
  eligibility         String?
  additionalInfo      String?
  applicationDeadline DateTime
  deadline            DateTime?
  startDate           DateTime?
  endDate             DateTime?
  minCgpa             Float?
  requiredSkills      String[]
  allowedDegrees      String[]
  allowedYears        Int[]
  postedById          String?
  postedByRole        Role?             @default(MENTOR)
  status              OpportunityStatus @default(PUBLISHED)

  // Targeting fields for HOD / Placement
  targetAudience      String?           // ALL_STUDENTS, SELECTED_STUDENTS, ALL_MENTORS, SELECTED_MENTORS, BOTH
  targetDepartment    String?
  targetYear          Int?
  targetSection       String?

  viewsCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  postedBy      User?                     @relation("PostedOpportunities", fields: [postedById], references: [id], onDelete: SetNull)
  registrations OpportunityRegistration[]
  applications  Application[]
  autofillSessions AutofillSession[]

  @@map("opportunities")
}

// ============================================================
// OPPORTUNITY REGISTRATION
// ============================================================

model OpportunityRegistration {
  id                      String                        @id @default(cuid())
  opportunityId           String
  studentId               String
  status                  OpportunityRegistrationStatus @default(STARTED)
  verificationMethod      String?                       // EXTENSION, STUDENT_CONFIRMATION, MANUAL, SYSTEM
  verifiedAt              DateTime?
  confirmedAt             DateTime?
  startedAt               DateTime?                     @default(now())
  externalRegistrationId  String?                       // Detected or entered registration/application ID
  confirmationEvidenceUrl String?                       // Screenshot / proof URL
  notes                   String?
  outcome                 String?                       // Participated, Finalist, Winner, Runner-up, Selected, Completed, Other
  role                    String?                       // Role or Position
  certificateUrl          String?
  initiatedAt             DateTime                      @default(now())
  appliedAt               DateTime?
  registeredAt            DateTime?
  completedAt             DateTime?
  updatedAt               DateTime                      @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, studentId])
  @@map("opportunity_registrations")
}

// ============================================================
// ACTIVITY
// ============================================================

model Activity {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String // e.g., "APPLICATION_ADDED", "INTERVIEW_SCHEDULED"
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id                String   @id @default(cuid())
  userId            String
  senderId          String?
  type              String?  // OPPORTUNITY_POSTED, OPPORTUNITY_REGISTERED, REGISTRATION_STATUS_CHANGED, etc.
  title             String
  message           String
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean  @default(false)
  link              String?
  createdAt         DateTime @default(now())

  user   User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ============================================================
// AUTOFILL SESSION
// ============================================================

model AutofillSession {
  id             String   @id @default(cuid())
  studentId      String
  opportunityId  String?
  sessionToken   String   @unique
  status         String   @default("CREATED") // CREATED, OPENED, FILLING, PAUSED, REVIEW, COMPLETED, EXPIRED
  fieldsDetected Int      @default(0)
  fieldsFilled   Int      @default(0)
  newFieldsSaved Int      @default(0)
  pauseReason    String?
  report         Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("autofill_sessions")
}

// ============================================================
// APPLY AGENT — persistent profile learning
// ============================================================

model CustomProfileField {
  id         String   @id @default(cuid())
  userId     String
  key        String
  category   String   @default("custom")
  label      String
  value      String
  source     String   @default("USER_ENTERED")
  verified   Boolean  @default(true)
  confidence Float    @default(1.0)
  enabled    Boolean  @default(true)
  sensitive  Boolean  @default(false)
  fillPolicy String   @default("AUTOMATIC") // AUTOMATIC | ASK_BEFORE_FILLING | NEVER_FILL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history ProfileFieldHistory[]

  @@unique([userId, key])
  @@map("custom_profile_fields")
}

model ProfileFieldHistory {
  id        String   @id @default(cuid())
  fieldId   String
  oldValue  String?
  newValue  String
  source    String
  updatedBy String   @default("USER")
  createdAt DateTime @default(now())

  field CustomProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("profile_field_history")
}

model FieldMappingMemory {
  id           String   @id @default(cuid())
  userId       String   @default("")
  fieldPattern String
  mappedField  String
  confidence   Float    @default(0.9)
  verified     Boolean  @default(true)
  siteHost     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, fieldPattern, siteHost])
  @@index([fieldPattern])
  @@map("field_mapping_memory")
}

model ApplicationDraftAnswer {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?
  sessionToken  String?
  fieldLabel    String
  fieldKey      String?
  value         String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("application_draft_answers")
}

model ExtensionAuthCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  state     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_auth_codes")
}

model AutofillAuditEvent {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String?
  domain       String
  status       String
  fieldKey     String?
  fieldLabel   String?
  detail       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("autofill_audit_events")
}

// ============================================================
// FORM BUILDER
// ============================================================

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FormAudienceType {
  HOD_DEPARTMENT
  MENTOR_ASSIGNED_STUDENTS
}

model Form {
  id                        String           @id @default(cuid())
  title                     String
  description               String?
  instructions              String?
  status                    FormStatus       @default(DRAFT)
  createdBy                 String
  ownerRole                 Role             @default(HOD)
  audienceType              FormAudienceType @default(HOD_DEPARTMENT)
  allowMultipleSubmissions  Boolean          @default(false)
  allowEditing              Boolean          @default(false)
  confirmationMessage       String?          @default("Your response has been submitted successfully.")
  redirectUrl               String?
  publishedAt               DateTime?
  closedAt                  DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  creator                   User             @relation("FormCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  fields                    FormField[]
  responses                 FormResponse[]

  @@map("forms")
}

model FormField {
  id          String   @id @default(cuid())
  formId      String
  fieldId     String   // Stable client-side field ID (e.g. field_8f91c2)
  type        String   // short-text, long-text, email, phone, number, date, dropdown, radio, checkbox, file, url, rating, yesno, section, paragraph, profile-field
  label       String
  description String?
  placeholder String?
  required    Boolean  @default(false)
  order       Int      @default(0)
  config      Json?    // options, min, max, allowedFileTypes, maxFileSize, profileKey, isReadOnly, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     FormResponseAnswer[]

  @@unique([formId, fieldId])
  @@map("form_fields")
}

model FormResponse {
  id          String               @id @default(cuid())
  formId      String
  studentId   String
  submittedAt DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  form        Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  student     User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     FormResponseAnswer[]

  @@map("form_responses")
}

model FormResponseAnswer {
  id          String       @id @default(cuid())
  responseId  String
  fieldId     String
  value       String?      // Simple string or JSON string for multi-values / files
  createdAt   DateTime     @default(now())

  response    FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field       FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("form_response_answers")
}

model AppFeature {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(true)
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_features")
}

model RolePermission {
  id        String   @id @default(cuid())
  role      Role
  resource  String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource, action])
  @@map("role_permissions")
}

model RoleSidebarItem {
  id        String   @id @default(cuid())
  role      Role
  title     String
  path      String
  order     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, title])
  @@map("role_sidebar_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
