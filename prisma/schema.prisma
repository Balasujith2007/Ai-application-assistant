generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(cuid())
  name                       String
  email                      String                      @unique
  password                   String?
  googleId                   String?                     @unique
  role                       Role                        @default(STUDENT)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  aiPreferences              Json?
  notificationPreferences    Json?
  privacySettings            Json?
  mentorId                   String?
  active                     Boolean                     @default(true)
  achievementHistories       AchievementHistory[]
  activities                 Activity[]
  applicationDrafts          ApplicationDraftAnswer[]
  applications               Application[]
  auditLogs                  AuditLog[]
  autofillAuditEvents        AutofillAuditEvent[]
  autofillSessions           AutofillSession[]
  coinTransactions           CoinTransaction[]
  customProfileFields        CustomProfileField[]
  dailyCheckIns              DailyCheckIn[]
  emailEvidences             EmailEvidence[]
  emailReviews               EmailStatusReview[]
  extensionAuthCodes         ExtensionAuthCode[]
  formResponses              FormResponse[]
  createdForms               Form[]                      @relation("FormCreator")
  interviews                 Interview[]
  leaderboardBoostTokens     LeaderboardBoostToken[]
  leaderboardSnapshots       LeaderboardSnapshot[]
  notificationDeliveries     NotificationDelivery[]
  sentNotifications          Notification[]              @relation("SentNotifications")
  notifications              Notification[]              @relation("UserNotifications")
  postedOpportunities        Opportunity[]               @relation("PostedOpportunities")
  registrations              OpportunityRegistration[]
  pointsLedgers              PointsLedger[]
  profile                    Profile?
  reviewedEvidences          RegistrationEvidence[]      @relation("ReviewedEvidences")
  registrationEvidences      RegistrationEvidence[]      @relation("StudentEvidences")
  resumes                    Resume[]
  shopPurchases              ShopPurchase[]
  streakRescueTokens         StreakRescueToken[]
  studentBadges              StudentBadge[]
  coinBalance                StudentCoinBalance?
  dailyStreaks               StudentDailyStreak[]
  emailIntegration           StudentEmailIntegration?
  studentRewards             StudentReward[]
  syncHistories              SyncHistory[]
  tasks                      Task[]
  mentor                     User?                       @relation("StudentMentor", fields: [mentorId], references: [id])
  students                   User[]                      @relation("StudentMentor")
  reviewedActivities         VerifiedActivity[]          @relation("ReviewedActivities")
  verifiedActivities         VerifiedActivity[]          @relation("StudentVerifiedActivities")
  verifiedProfiles           VerifiedProfile[]
  weeklyPerformanceSnapshots WeeklyPerformanceSnapshot[]

  @@index([role])
  @@index([mentorId])
  @@map("users")
}

model VerifiedProfile {
  id                 String   @id @default(cuid())
  studentId          String
  platform           String
  profileUrl         String
  username           String?
  verificationStatus String   @default("UNVERIFIED")
  verifiedAt         DateTime @default(now())
  publicMetadata     Json?
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@map("verified_profiles")
}

model Profile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  phone                 String?
  department            String?
  year                  Int?
  section               String?
  college               String?
  location              String?
  careerObjective       String?
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  careerPreferences     Json?
  employeeId            String?
  registerNo            String?        @unique
  codolioUrl            String?
  dob                   String?
  nationality           String?
  country               String?
  state                 String?
  preferredLocation     String?
  pinCode               String?
  preferredRole         String?
  expectedSalary        String?
  tenthSchool           String?
  tenthPercentage       String?
  twelfthSchool         String?
  twelfthPercentage     String?
  collegeName           String?
  cgpa                  String?
  collegeJoiningYear    Int?
  collegeGraduationYear Int?
  major                 String?
  minor                 String?
  previousWorkMode      String?
  preferredWorkMode     String?
  disabilityStatus      String?
  gender                String?
  codechefUrl           String?
  leetcodeUrl           String?
  codeforcesUrl         String?
  photoPublicId         String?
  profilePhotoUrl       String?
  equippedBadgeId       String?
  equippedFrameRewardId String?
  equippedTitleRewardId String?
  showcaseBadgeIds      String[]       @default([])
  education             Education[]
  experiences           Experience[]
  skills                ProfileSkill[]
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects              Project[]

  @@index([department, year, section])
  @@index([department])
  @@map("profiles")
}

model Skill {
  id       String         @id @default(cuid())
  name     String         @unique
  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  skillId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

model Education {
  id           String  @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?
  minor        String?
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("education")
}

model Project {
  id           String    @id @default(cuid())
  profileId    String
  title        String
  description  String?
  technologies String[]
  githubUrl    String?
  liveUrl      String?
  startDate    DateTime?
  endDate      DateTime?
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Experience {
  id               String    @id @default(cuid())
  profileId        String
  company          String
  role             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)
  duration         String?
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Resume {
  id             String    @id @default(cuid())
  userId         String
  fileName       String
  fileUrl        String
  originalName   String
  mimeType       String?
  fileSize       Int?
  isActive       Boolean   @default(true)
  uploadedAt     DateTime  @default(now())
  reviewFeedback String?
  reviewStatus   String?   @default("PENDING_REVIEW")
  reviewedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("resumes")
}

model Application {
  id               String            @id @default(cuid())
  userId           String
  companyName      String
  position         String
  applicationType  ApplicationType   @default(INTERNSHIP)
  applicationUrl   String?
  status           ApplicationStatus @default(SAVED)
  appliedDate      DateTime?
  deadline         DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  description      String?
  location         String?
  nextAction       String?
  resumeVersion    String?
  salary           String?
  codolioUrl       String?
  githubUrl        String?
  opportunityId    String?
  statusConfidence Float?            @default(1.0)
  statusSource     String?           @default("MANUAL")
  statusUpdatedAt  DateTime?
  opportunity      Opportunity?      @relation(fields: [opportunityId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEvidences   EmailEvidence[]

  @@index([userId])
  @@index([userId, status])
  @@index([opportunityId])
  @@map("applications")
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  category    TaskCategory @default(OTHER)
  priority    TaskPriority @default(MEDIUM)
  isCompleted Boolean      @default(false)
  deadline    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isCompleted])
  @@map("tasks")
}

model Interview {
  id          String        @id @default(cuid())
  userId      String
  companyName String
  role        String
  type        InterviewType @default(TECHNICAL)
  date        DateTime
  time        String?
  location    String?
  prepTopics  String[]
  feedback    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("interviews")
}

model Opportunity {
  id                    String                    @id @default(cuid())
  companyName           String?
  role                  String?
  type                  OpportunityType           @default(JOB)
  location              String?
  salary                String?
  description           String
  applyUrl              String?
  deadline              DateTime?
  minCgpa               Float?
  requiredSkills        String[]
  allowedDegrees        String[]
  allowedYears          Int[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  additionalInfo        String?
  applicationDeadline   DateTime
  eligibility           String?
  endDate               DateTime?
  mode                  OpportunityMode           @default(ONLINE)
  openings              Int?
  opportunityUrl        String?
  organization          String
  postedById            String?
  postedByRole          Role?                     @default(MENTOR)
  prize                 String?
  registrationUrl       String?
  startDate             DateTime?
  status                OpportunityStatus         @default(PUBLISHED)
  stipend               String?
  targetAudience        String?
  targetDepartment      String?
  targetSection         String?
  targetYear            Int?
  title                 String
  viewsCount            Int                       @default(0)
  applications          Application[]
  autofillSessions      AutofillSession[]
  postedBy              User?                     @relation("PostedOpportunities", fields: [postedById], references: [id])
  registrations         OpportunityRegistration[]
  reminders             OpportunityReminder[]
  registrationEvidences RegistrationEvidence[]
  verifiedActivities    VerifiedActivity[]

  @@index([status, deadline])
  @@index([type, status])
  @@map("opportunities")
}

model OpportunityRegistration {
  id                      String                        @id @default(cuid())
  opportunityId           String
  studentId               String
  status                  OpportunityRegistrationStatus @default(STARTED)
  notes                   String?
  registeredAt            DateTime?
  updatedAt               DateTime                      @updatedAt
  initiatedAt             DateTime                      @default(now())
  appliedAt               DateTime?
  certificateUrl          String?
  completedAt             DateTime?
  outcome                 String?
  role                    String?
  startedAt               DateTime?                     @default(now())
  confirmationEvidenceUrl String?
  confirmedAt             DateTime?
  externalRegistrationId  String?
  verificationMethod      String?
  verifiedAt              DateTime?
  opportunity             Opportunity                   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student                 User                          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  statusHistory           OpportunityStatusHistory[]
  workflowSteps           OpportunityWorkflowStep[]
  evidences               RegistrationEvidence[]

  @@unique([opportunityId, studentId])
  @@index([studentId])
  @@index([studentId, status])
  @@map("opportunity_registrations")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activities")
}

model Notification {
  id                String   @id @default(cuid())
  userId            String
  title             String
  message           String
  isRead            Boolean  @default(false)
  link              String?
  createdAt         DateTime @default(now())
  relatedEntityId   String?
  relatedEntityType String?
  senderId          String?
  type              String?
  sender            User?    @relation("SentNotifications", fields: [senderId], references: [id])
  user              User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model AutofillSession {
  id             String       @id @default(cuid())
  studentId      String
  opportunityId  String?
  sessionToken   String       @unique
  status         String       @default("CREATED")
  fieldsDetected Int          @default(0)
  fieldsFilled   Int          @default(0)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  newFieldsSaved Int          @default(0)
  pauseReason    String?
  report         Json?
  updatedAt      DateTime     @default(now()) @updatedAt
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("autofill_sessions")
}

model CustomProfileField {
  id         String                @id @default(cuid())
  userId     String
  key        String
  category   String                @default("custom")
  label      String
  value      String
  source     String                @default("USER_ENTERED")
  verified   Boolean               @default(true)
  confidence Float                 @default(1.0)
  enabled    Boolean               @default(true)
  sensitive  Boolean               @default(false)
  fillPolicy String                @default("AUTOMATIC")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history    ProfileFieldHistory[]

  @@unique([userId, key])
  @@map("custom_profile_fields")
}

model ProfileFieldHistory {
  id        String             @id @default(cuid())
  fieldId   String
  oldValue  String?
  newValue  String
  source    String
  createdAt DateTime           @default(now())
  updatedBy String             @default("USER")
  field     CustomProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("profile_field_history")
}

model FieldMappingMemory {
  id           String   @id @default(cuid())
  userId       String   @default("")
  fieldPattern String
  mappedField  String
  confidence   Float    @default(0.9)
  verified     Boolean  @default(true)
  siteHost     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, fieldPattern, siteHost])
  @@index([fieldPattern])
  @@map("field_mapping_memory")
}

model ApplicationDraftAnswer {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?
  sessionToken  String?
  fieldLabel    String
  fieldKey      String?
  value         String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("application_draft_answers")
}

model ExtensionAuthCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  state     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_auth_codes")
}

model AutofillAuditEvent {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String?
  domain       String
  status       String
  fieldKey     String?
  fieldLabel   String?
  detail       String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("autofill_audit_events")
}

model Form {
  id                       String           @id @default(cuid())
  title                    String
  description              String?
  instructions             String?
  status                   FormStatus       @default(DRAFT)
  createdBy                String
  allowMultipleSubmissions Boolean          @default(false)
  allowEditing             Boolean          @default(false)
  confirmationMessage      String?          @default("Your response has been submitted successfully.")
  redirectUrl              String?
  publishedAt              DateTime?
  closedAt                 DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  audienceType             FormAudienceType @default(HOD_DEPARTMENT)
  ownerRole                Role             @default(HOD)
  fields                   FormField[]
  responses                FormResponse[]
  creator                  User             @relation("FormCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("forms")
}

model FormField {
  id          String               @id @default(cuid())
  formId      String
  fieldId     String
  type        String
  label       String
  description String?
  placeholder String?
  required    Boolean              @default(false)
  order       Int                  @default(0)
  config      Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  form        Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     FormResponseAnswer[]

  @@unique([formId, fieldId])
  @@map("form_fields")
}

model FormResponse {
  id          String               @id @default(cuid())
  formId      String
  studentId   String
  submittedAt DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  answers     FormResponseAnswer[]
  form        Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  student     User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("form_responses")
}

model FormResponseAnswer {
  id         String       @id @default(cuid())
  responseId String
  fieldId    String
  value      String?
  createdAt  DateTime     @default(now())
  field      FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  response   FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("form_response_answers")
}

model AppFeature {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(true)
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_features")
}

model RolePermission {
  id        String   @id @default(cuid())
  role      Role
  resource  String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource, action])
  @@map("role_permissions")
}

model RoleSidebarItem {
  id        String   @id @default(cuid())
  role      Role
  title     String
  path      String
  order     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, title])
  @@map("role_sidebar_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model NotificationDelivery {
  id                String    @id @default(cuid())
  userId            String?
  recipientPhone    String
  notificationType  String
  provider          String
  providerMessageId String?
  status            String
  failureReason     String?
  idempotencyKey    String?   @unique
  metadata          Json?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notification_deliveries")
}

model OpportunityReminder {
  id             String                  @id @default(cuid())
  opportunityId  String
  reminderType   OpportunityReminderType
  status         ReminderExecutionStatus @default(SCHEDULED)
  scheduledFor   DateTime
  sentAt         DateTime?
  recipientCount Int                     @default(0)
  failureReason  String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  opportunity    Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, reminderType])
  @@index([scheduledFor, status])
  @@map("opportunity_reminders")
}

model OpportunityWorkflowStep {
  id             String                  @id @default(cuid())
  registrationId String
  stepType       WorkflowStepType        @default(INTERVIEW)
  title          String
  description    String?
  status         WorkflowStepStatus      @default(PENDING)
  deadline       DateTime?
  scheduledAt    DateTime?
  completedAt    DateTime?
  notes          String?
  meetingLink    String?
  submissionUrl  String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  registration   OpportunityRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([status])
  @@map("opportunity_workflow_steps")
}

model OpportunityStatusHistory {
  id             String                  @id @default(cuid())
  registrationId String
  fromStatus     String?
  toStatus       String
  changedById    String?
  reason         String?
  notes          String?
  createdAt      DateTime                @default(now())
  registration   OpportunityRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([createdAt])
  @@map("opportunity_status_histories")
}

model StudentEmailIntegration {
  id                    String    @id @default(cuid())
  userId                String    @unique
  provider              String    @default("GMAIL")
  emailAddress          String
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  syncStatus            String    @default("DISCONNECTED")
  lastSyncedAt          DateTime?
  lastHistoryId         String?
  autoSyncEnabled       Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_email_integrations")
}

model EmailEvidence {
  id              String            @id @default(cuid())
  applicationId   String?
  studentId       String
  sourceMessageId String
  senderEmail     String
  senderName      String?
  companyName     String
  detectedStatus  ApplicationStatus
  confidence      Float             @default(1.0)
  receivedDate    DateTime
  subject         String
  cleanSnippet    String
  matchedKeywords String[]
  isVerified      Boolean           @default(true)
  createdAt       DateTime          @default(now())
  application     Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student         User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sourceMessageId])
  @@index([studentId])
  @@index([applicationId])
  @@map("email_evidences")
}

model EmailStatusReview {
  id              String            @id @default(cuid())
  studentId       String
  sourceMessageId String
  senderEmail     String
  senderName      String?
  detectedCompany String?
  detectedRole    String?
  detectedStatus  ApplicationStatus
  confidence      Float
  subject         String
  cleanSnippet    String
  candidateAppIds Json?
  status          String            @default("PENDING")
  resolvedAppId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  student         User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sourceMessageId])
  @@index([studentId])
  @@index([status])
  @@map("email_status_reviews")
}

model RegistrationEvidence {
  id                 String                  @id @default(cuid())
  registrationId     String
  opportunityId      String
  studentId          String
  evidenceFileUrl    String
  filePath           String
  fileName           String
  fileSize           Int
  mimeType           String
  fileHash           String?
  status             String                  @default("PENDING_REVIEW")
  verificationMethod String                  @default("OCR_SCREENSHOT")
  ocrTextSnippet     String?
  ocrConfidence      Float?                  @default(0.0)
  extractedData      Json?
  validationResults  Json?
  mismatchReasons    String[]                @default([])
  isAuthentic        Boolean                 @default(false)
  reviewerId         String?
  reviewDecision     String?
  reviewerNotes      String?
  reviewedAt         DateTime?
  submittedAt        DateTime                @default(now())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  opportunity        Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  registration       OpportunityRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviewer           User?                   @relation("ReviewedEvidences", fields: [reviewerId], references: [id])
  student            User                    @relation("StudentEvidences", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([studentId])
  @@index([opportunityId])
  @@index([fileHash])
  @@index([status])
  @@map("registration_evidences")
}

model VerifiedActivity {
  id                 String         @id @default(cuid())
  studentId          String
  sourceType         String
  sourcePlatform     String
  sourceAccountId    String?
  activityType       String
  externalActivityId String
  opportunityId      String?
  verificationStatus String         @default("PENDING")
  verificationMethod String?
  evidenceReference  String?
  verifiedAt         DateTime?
  occurredAt         DateTime?
  lastSyncedAt       DateTime?      @default(now())
  reviewerId         String?
  rejectionReason    String?
  rawMetadata        Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
