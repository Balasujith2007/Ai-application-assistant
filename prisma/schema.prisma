// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  MENTOR
  FACULTY
  HOD
  PLACEMENT_CELL
  ADMIN
  SUPER_ADMIN
}

enum ApplicationType {
  INTERNSHIP
  JOB
  HACKATHON
  COMPETITION
  WORKSHOP
  SCHOLARSHIP
  OTHER
}

enum ApplicationStatus {
  SAVED
  INITIATED
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  DISQUALIFIED
  WITHDRAWN
}

enum OpportunityType {
  JOB
  FULL_TIME
  INTERNSHIP
  HACKATHON
  COMPETITION
  SCHOLARSHIP
  WORKSHOP
  OTHER
}

enum OpportunityMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum OpportunityRegistrationStatus {
  STARTED
  INITIATED
  IN_PROGRESS
  STUDENT_CONFIRMED
  PENDING_VERIFICATION
  PROOF_SUBMITTED
  VERIFYING
  PENDING_REVIEW
  VERIFIED
  REGISTERED
  ONGOING
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  DISQUALIFIED
  WITHDRAWN
  FAILED
  CANCELLED
  COMPLETED
}

// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role     @default(STUDENT)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notificationPreferences Json?
  privacySettings Json?
  aiPreferences Json?

  profile              Profile?
  verifiedProfiles     VerifiedProfile[]
  resumes              Resume[]
  applications         Application[]
  tasks                Task[]
  interviews           Interview[]
  activities           Activity[]
  notifications        Notification[] @relation("UserNotifications")
  sentNotifications    Notification[] @relation("SentNotifications")
  postedOpportunities  Opportunity[]  @relation("PostedOpportunities")
  registrations        OpportunityRegistration[]
  autofillSessions     AutofillSession[]
  customProfileFields  CustomProfileField[]
  applicationDrafts    ApplicationDraftAnswer[]
  extensionAuthCodes   ExtensionAuthCode[]
  autofillAuditEvents  AutofillAuditEvent[]
  createdForms         Form[]                 @relation("FormCreator")
  formResponses        FormResponse[]
  auditLogs            AuditLog[]
  notificationDeliveries NotificationDelivery[]
  emailIntegration       StudentEmailIntegration?
  emailEvidences         EmailEvidence[]
  emailReviews           EmailStatusReview[]
  registrationEvidences  RegistrationEvidence[]  @relation("StudentEvidences")
  reviewedEvidences      RegistrationEvidence[]  @relation("ReviewedEvidences")
  verifiedActivities     VerifiedActivity[]      @relation("StudentVerifiedActivities")
  reviewedActivities     VerifiedActivity[]      @relation("ReviewedActivities")
  pointsLedgers          PointsLedger[]
  syncHistories          SyncHistory[]
  leaderboardSnapshots   LeaderboardSnapshot[]

  // Mentor-Student relationship
  mentorId      String?
  mentor        User?   @relation("StudentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students      User[]  @relation("StudentMentor")

  @@index([role])
  @@index([mentorId])
  @@map("users")
}

// ============================================================
// VERIFIED PROFILE
// ============================================================

model VerifiedProfile {
  id                 String   @id @default(cuid())
  studentId          String
  platform           String   // GITHUB, LINKEDIN, CODOLIO
  profileUrl         String
  username           String?
  verificationStatus String   @default("UNVERIFIED") // VERIFIED, FORMAT_VERIFIED, UNVERIFIED, FAILED
  verifiedAt         DateTime @default(now())
  publicMetadata     Json?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@map("verified_profiles")
}

// ============================================================
// PROFILE
// ============================================================

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  department       String?
  year             Int?
  section          String?
  college          String?
  location         String?
  careerObjective  String?
  linkedinUrl      String?
  githubUrl        String?
  portfolioUrl     String?
  codolioUrl       String?
  codechefUrl      String?
  leetcodeUrl      String?
  codeforcesUrl    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  careerPreferences Json?
  employeeId       String?
  registerNo       String?  @unique

  // Personal Information Extensions
  dob              String?
  gender           String?
  disabilityStatus String?
  nationality      String?
  country          String?
  state            String?
  preferredLocation String?
  pinCode          String?

  // Career Information
  preferredRole    String?
  expectedSalary   String?

  // School Education
  tenthSchool      String?
  tenthPercentage  String?
  twelfthSchool    String?
  twelfthPercentage String?

  // College Education
  collegeName      String?
  cgpa             String?
  collegeJoiningYear Int?
  collegeGraduationYear Int?
  major            String?
  minor            String?

  // Work Preferences
  previousWorkMode String?
  preferredWorkMode String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  education   Education[]
  projects    Project[]
  experiences Experience[]
  skills      ProfileSkill[]

  @@map("profiles")
}

// ============================================================
// SKILL (many-to-many via ProfileSkill)
// ============================================================

model Skill {
  id       String         @id @default(cuid())
  name     String         @unique
  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  skillId   String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

// ============================================================
// EDUCATION
// ============================================================

model Education {
  id           String  @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?
  minor        String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("education")
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id           String    @id @default(cuid())
  profileId    String
  title        String
  description  String?
  technologies String[]
  githubUrl    String?
  liveUrl      String?
  startDate    DateTime?
  endDate      DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ============================================================
// EXPERIENCE
// ============================================================

model Experience {
  id               String    @id @default(cuid())
  profileId        String
  company          String
  role             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)
  duration         String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

// ============================================================
// RESUME
// ============================================================

model Resume {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  fileUrl      String
  originalName String
  mimeType     String?
  fileSize     Int?
  isActive     Boolean  @default(true)
  uploadedAt   DateTime @default(now())

  // Mentor review fields
  reviewStatus   String?   @default("PENDING_REVIEW") // PENDING_REVIEW, REVIEWED, CHANGES_REQUESTED
  reviewFeedback String?
  reviewedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("resumes")
}

// ============================================================
// APPLICATION
// ============================================================

model Application {
  id              String            @id @default(cuid())
  userId          String
  opportunityId   String?
  companyName     String
  position        String
  applicationType ApplicationType   @default(INTERNSHIP)
  applicationUrl  String?
  location        String?
  salary          String?
  description     String?
  nextAction      String?
  resumeVersion   String?
  status          ApplicationStatus @default(SAVED)
  statusSource    String?           @default("MANUAL") // MANUAL, COMPANY_EMAIL, EXTENSION, SYSTEM
  statusConfidence Float?           @default(1.0)
  statusUpdatedAt DateTime?
  appliedDate     DateTime?
  deadline        DateTime?
  notes           String?
  githubUrl       String?
  codolioUrl      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  emailEvidences EmailEvidence[]

  @@index([userId])
  @@index([userId, status])
  @@index([opportunityId])
  @@map("applications")
}

// ============================================================
// TASK
// ============================================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskCategory {
  APPLICATION
  PREPARATION
  FOLLOW_UP
  OTHER
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  category    TaskCategory @default(OTHER)
  priority    TaskPriority @default(MEDIUM)
  isCompleted Boolean      @default(false)
  deadline    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isCompleted])
  @@map("tasks")
}

// ============================================================
// INTERVIEW
// ============================================================

enum InterviewType {
  TECHNICAL
  HR
  MANAGER
  ONLINE_ASSESSMENT
  OTHER
}

model Interview {
  id          String        @id @default(cuid())
  userId      String
  companyName String
  role        String
  type        InterviewType @default(TECHNICAL)
  date        DateTime
  time        String?
  location    String?
  prepTopics  String[]
  feedback    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("interviews")
}

// ============================================================
// OPPORTUNITY
// ============================================================

model Opportunity {
  id                  String            @id @default(cuid())
  title               String
  organization        String
  companyName         String?
  role                String?
  type                OpportunityType   @default(JOB)
  description         String
  opportunityUrl      String?
  registrationUrl     String?
  applyUrl            String?
  location            String?
  mode                OpportunityMode   @default(ONLINE)
  salary              String?
  stipend             String?
  prize               String?
  openings            Int?
  eligibility         String?
  additionalInfo      String?
  applicationDeadline DateTime
  deadline            DateTime?
  startDate           DateTime?
  endDate             DateTime?
  minCgpa             Float?
  requiredSkills      String[]
  allowedDegrees      String[]
  allowedYears        Int[]
  postedById          String?
  postedByRole        Role?             @default(MENTOR)
  status              OpportunityStatus @default(PUBLISHED)

  // Targeting fields for HOD / Placement
  targetAudience      String?           // ALL_STUDENTS, SELECTED_STUDENTS, ALL_MENTORS, SELECTED_MENTORS, BOTH
  targetDepartment    String?
  targetYear          Int?
  targetSection       String?

  viewsCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  postedBy      User?                     @relation("PostedOpportunities", fields: [postedById], references: [id], onDelete: SetNull)
  registrations OpportunityRegistration[]
  applications  Application[]
  autofillSessions AutofillSession[]
  reminders     OpportunityReminder[]
  registrationEvidences RegistrationEvidence[]
  verifiedActivities VerifiedActivity[]

  @@index([status, deadline])
  @@index([type, status])
  @@map("opportunities")
}

// ============================================================
// OPPORTUNITY REGISTRATION
// ============================================================

model OpportunityRegistration {
  id                      String                        @id @default(cuid())
  opportunityId           String
  studentId               String
  status                  OpportunityRegistrationStatus @default(STARTED)
  verificationMethod      String?                       // EXTENSION, STUDENT_CONFIRMATION, MANUAL, SYSTEM
  verifiedAt              DateTime?
  confirmedAt             DateTime?
  startedAt               DateTime?                     @default(now())
  externalRegistrationId  String?                       // Detected or entered registration/application ID
  confirmationEvidenceUrl String?                       // Screenshot / proof URL
  notes                   String?
  outcome                 String?                       // Participated, Finalist, Winner, Runner-up, Selected, Completed, Other
  role                    String?                       // Role or Position
  certificateUrl          String?
  initiatedAt             DateTime                      @default(now())
  appliedAt               DateTime?
  registeredAt            DateTime?
  completedAt             DateTime?
  updatedAt               DateTime                      @updatedAt

  opportunity   Opportunity                @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student       User                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workflowSteps OpportunityWorkflowStep[]
  statusHistory OpportunityStatusHistory[]
  evidences     RegistrationEvidence[]

  @@unique([opportunityId, studentId])
  @@index([studentId])
  @@index([studentId, status])
  @@map("opportunity_registrations")
}

// ============================================================
// ACTIVITY
// ============================================================

model Activity {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String // e.g., "APPLICATION_ADDED", "INTERVIEW_SCHEDULED"
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activities")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id                String   @id @default(cuid())
  userId            String
  senderId          String?
  type              String?  // OPPORTUNITY_POSTED, OPPORTUNITY_REGISTERED, REGISTRATION_STATUS_CHANGED, etc.
  title             String
  message           String
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean  @default(false)
  link              String?
  createdAt         DateTime @default(now())

  user   User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================================
// AUTOFILL SESSION
// ============================================================

model AutofillSession {
  id             String   @id @default(cuid())
  studentId      String
  opportunityId  String?
  sessionToken   String   @unique
  status         String   @default("CREATED") // CREATED, OPENED, FILLING, PAUSED, REVIEW, COMPLETED, EXPIRED
  fieldsDetected Int      @default(0)
  fieldsFilled   Int      @default(0)
  newFieldsSaved Int      @default(0)
  pauseReason    String?
  report         Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("autofill_sessions")
}

// ============================================================
// APPLY AGENT — persistent profile learning
// ============================================================

model CustomProfileField {
  id         String   @id @default(cuid())
  userId     String
  key        String
  category   String   @default("custom")
  label      String
  value      String
  source     String   @default("USER_ENTERED")
  verified   Boolean  @default(true)
  confidence Float    @default(1.0)
  enabled    Boolean  @default(true)
  sensitive  Boolean  @default(false)
  fillPolicy String   @default("AUTOMATIC") // AUTOMATIC | ASK_BEFORE_FILLING | NEVER_FILL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history ProfileFieldHistory[]

  @@unique([userId, key])
  @@map("custom_profile_fields")
}

model ProfileFieldHistory {
  id        String   @id @default(cuid())
  fieldId   String
  oldValue  String?
  newValue  String
  source    String
  updatedBy String   @default("USER")
  createdAt DateTime @default(now())

  field CustomProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("profile_field_history")
}

model FieldMappingMemory {
  id           String   @id @default(cuid())
  userId       String   @default("")
  fieldPattern String
  mappedField  String
  confidence   Float    @default(0.9)
  verified     Boolean  @default(true)
  siteHost     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, fieldPattern, siteHost])
  @@index([fieldPattern])
  @@map("field_mapping_memory")
}

model ApplicationDraftAnswer {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?
  sessionToken  String?
  fieldLabel    String
  fieldKey      String?
  value         String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("application_draft_answers")
}

model ExtensionAuthCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  state     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("extension_auth_codes")
}

model AutofillAuditEvent {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String?
  domain       String
  status       String
  fieldKey     String?
  fieldLabel   String?
  detail       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("autofill_audit_events")
}

// ============================================================
// FORM BUILDER
// ============================================================

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FormAudienceType {
  HOD_DEPARTMENT
  MENTOR_ASSIGNED_STUDENTS
}

model Form {
  id                        String           @id @default(cuid())
  title                     String
  description               String?
  instructions              String?
  status                    FormStatus       @default(DRAFT)
  createdBy                 String
  ownerRole                 Role             @default(HOD)
  audienceType              FormAudienceType @default(HOD_DEPARTMENT)
  allowMultipleSubmissions  Boolean          @default(false)
  allowEditing              Boolean          @default(false)
  confirmationMessage       String?          @default("Your response has been submitted successfully.")
  redirectUrl               String?
  publishedAt               DateTime?
  closedAt                  DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  creator                   User             @relation("FormCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  fields                    FormField[]
  responses                 FormResponse[]

  @@map("forms")
}

model FormField {
  id          String   @id @default(cuid())
  formId      String
  fieldId     String   // Stable client-side field ID (e.g. field_8f91c2)
  type        String   // short-text, long-text, email, phone, number, date, dropdown, radio, checkbox, file, url, rating, yesno, section, paragraph, profile-field
  label       String
  description String?
  placeholder String?
  required    Boolean  @default(false)
  order       Int      @default(0)
  config      Json?    // options, min, max, allowedFileTypes, maxFileSize, profileKey, isReadOnly, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     FormResponseAnswer[]

  @@unique([formId, fieldId])
  @@map("form_fields")
}

model FormResponse {
  id          String               @id @default(cuid())
  formId      String
  studentId   String
  submittedAt DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  form        Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  student     User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     FormResponseAnswer[]

  @@map("form_responses")
}

model FormResponseAnswer {
  id          String       @id @default(cuid())
  responseId  String
  fieldId     String
  value       String?      // Simple string or JSON string for multi-values / files
  createdAt   DateTime     @default(now())

  response    FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field       FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("form_response_answers")
}

model AppFeature {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(true)
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_features")
}

model RolePermission {
  id        String   @id @default(cuid())
  role      Role
  resource  String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource, action])
  @@map("role_permissions")
}

model RoleSidebarItem {
  id        String   @id @default(cuid())
  role      Role
  title     String
  path      String
  order     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, title])
  @@map("role_sidebar_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ============================================================
// NOTIFICATION DELIVERY TRACKING
// ============================================================

model NotificationDelivery {
  id                String    @id @default(cuid())
  userId            String?
  recipientPhone    String
  notificationType  String
  provider          String    // MOCK, TWILIO
  providerMessageId String?
  status            String    // PENDING, SENT, DELIVERED, FAILED, SKIPPED, MOCKED
  failureReason     String?
  idempotencyKey    String?   @unique
  metadata          Json?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notification_deliveries")
}

// ============================================================
// OPPORTUNITY REMINDER
// ============================================================

enum OpportunityReminderType {
  THREE_DAY
  ONE_DAY
  DEADLINE_CLOSED
  CUSTOM
}

enum ReminderExecutionStatus {
  SCHEDULED
  SENT
  FAILED
  SKIPPED
}

model OpportunityReminder {
  id             String                  @id @default(cuid())
  opportunityId  String
  reminderType   OpportunityReminderType
  status         ReminderExecutionStatus @default(SCHEDULED)
  scheduledFor   DateTime
  sentAt         DateTime?
  recipientCount Int                     @default(0)
  failureReason  String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, reminderType])
  @@index([scheduledFor, status])
  @@map("opportunity_reminders")
}

// ============================================================
// OPPORTUNITY WORKFLOW STEP
// ============================================================

enum WorkflowStepType {
  INTERVIEW
  TECHNICAL_ASSESSMENT
  DOCUMENT_SUBMISSION
  EXTERNAL_VERIFICATION
  JOINING
  OTHER
}

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  WAIVED
}

model OpportunityWorkflowStep {
  id             String             @id @default(cuid())
  registrationId String
  stepType       WorkflowStepType   @default(INTERVIEW)
  title          String
  description    String?
  status         WorkflowStepStatus @default(PENDING)
  deadline       DateTime?
  scheduledAt    DateTime?
  completedAt    DateTime?
  notes          String?
  meetingLink    String?
  submissionUrl  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  registration OpportunityRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([status])
  @@map("opportunity_workflow_steps")
}

// ============================================================
// OPPORTUNITY STATUS HISTORY
// ============================================================

model OpportunityStatusHistory {
  id             String   @id @default(cuid())
  registrationId String
  fromStatus     String?
  toStatus       String
  changedById    String?
  reason         String?
  notes          String?
  createdAt      DateTime @default(now())

  registration OpportunityRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([createdAt])
  @@map("opportunity_status_histories")
}

// ============================================================
// COMPANY-EMAIL STATUS TRACKING & INTEGRATION
// ============================================================

model StudentEmailIntegration {
  id                    String    @id @default(cuid())
  userId                String    @unique
  provider              String    @default("GMAIL") // GMAIL, OUTLOOK, FORWARDING
  emailAddress          String
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  syncStatus            String    @default("DISCONNECTED") // CONNECTED, SYNCING, ERROR, DISCONNECTED
  lastSyncedAt          DateTime?
  lastHistoryId         String?
  autoSyncEnabled       Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_email_integrations")
}

model EmailEvidence {
  id              String            @id @default(cuid())
  applicationId   String?
  studentId       String
  sourceMessageId String
  senderEmail     String
  senderName      String?
  companyName     String
  detectedStatus  ApplicationStatus
  confidence      Float             @default(1.0)
  receivedDate    DateTime
  subject         String
  cleanSnippet    String
  matchedKeywords String[]
  isVerified      Boolean           @default(true)
  createdAt       DateTime          @default(now())

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sourceMessageId])
  @@index([studentId])
  @@index([applicationId])
  @@map("email_evidences")
}

model EmailStatusReview {
  id              String            @id @default(cuid())
  studentId       String
  sourceMessageId String
  senderEmail     String
  senderName      String?
  detectedCompany String?
  detectedRole    String?
  detectedStatus  ApplicationStatus
  confidence      Float
  subject         String
  cleanSnippet    String
  candidateAppIds Json?             // Array of candidate application objects [{ id, companyName, position, score }]
  status          String            @default("PENDING") // PENDING, CONFIRMED, DISMISSED
  resolvedAppId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sourceMessageId])
  @@index([studentId])
  @@index([status])
  @@map("email_status_reviews")
}

// ============================================================
// REGISTRATION VERIFICATION EVIDENCE
// ============================================================

model RegistrationEvidence {
  id                 String    @id @default(cuid())
  registrationId     String
  opportunityId      String
  studentId          String
  evidenceFileUrl    String
  filePath           String
  fileName           String
  fileSize           Int
  mimeType           String
  fileHash           String?
  status             String    @default("PENDING_REVIEW") // PROOF_SUBMITTED, VERIFYING, PENDING_REVIEW, VERIFIED, REJECTED, FAILED
  verificationMethod String    @default("OCR_SCREENSHOT") // OCR_SCREENSHOT, EXTENSION, OFFICIAL_API, MANUAL_REVIEW
  ocrTextSnippet     String?
  ocrConfidence      Float?    @default(0.0)
  extractedData      Json?
  validationResults  Json?
  mismatchReasons    String[]  @default([])
  isAuthentic        Boolean   @default(false)
  reviewerId         String?
  reviewDecision     String?   // APPROVED, REJECTED
  reviewerNotes      String?
  reviewedAt         DateTime?
  submittedAt        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  registration OpportunityRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student      User                    @relation("StudentEvidences", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer     User?                   @relation("ReviewedEvidences", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([studentId])
  @@index([opportunityId])
  @@index([fileHash])
  @@index([status])
  @@map("registration_evidences")
}

// ============================================================
// VERIFIED CLASS LEADERBOARD MODELS
// ============================================================

model VerifiedActivity {
  id                 String    @id @default(cuid())
  studentId          String
  sourceType         String    // CONTEST, HACKATHON, INTERNSHIP, CONSISTENCY
  sourcePlatform     String    // CODEFORCES, LEETCODE, CODECHEF, CODOLIO, GITHUB, CAREERAI
  sourceAccountId    String?   // External handle, username, or registrationId
  activityType       String    // CONTEST_PARTICIPATION, RATING_ACHIEVEMENT, PROBLEMS_SOLVED, HACKATHON_REGISTRATION, HACKATHON_PARTICIPATION, HACKATHON_WINNER, INTERNSHIP_APPLICATION, INTERNSHIP_INTERVIEW, INTERNSHIP_OFFER, CONSISTENCY_STREAK
  externalActivityId String    // Unique external activity identifier for deduplication
  opportunityId      String?
  verificationStatus String    @default("PENDING") // VERIFIED, PENDING_REVIEW, REJECTED, UNAVAILABLE
  verificationMethod String?   // OFFICIAL_API, REVIEWER_APPROVAL, SYSTEM_CROSS_CHECK
  evidenceReference  String?
  verifiedAt         DateTime?
  occurredAt         DateTime?
  lastSyncedAt       DateTime? @default(now())
  reviewerId         String?
  rejectionReason    String?
  rawMetadata        Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student            User         @relation("StudentVerifiedActivities", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer           User?        @relation("ReviewedActivities", fields: [reviewerId], references: [id], onDelete: SetNull)
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  pointsEntries      PointsLedger[]

  @@unique([studentId, sourceType, sourcePlatform, externalActivityId, activityType], name: "studentId_sourceType_sourcePlatform_externalActivityId_activityType")
  @@index([studentId, verificationStatus])
  @@index([opportunityId])
  @@map("verified_activities")
}

model PointsLedger {
  id                 String   @id @default(cuid())
  studentId          String
  verifiedActivityId String
  category           String   // CODING, HACKATHON, INTERNSHIP, CONSISTENCY
  pointsAwarded      Float
  scoringRuleVersion String   @default("1.0.0")
  reason             String
  periodKey          String   // e.g. 2026-W42, 2026-M10, 2026-S2, ALL_TIME
  createdAt          DateTime @default(now())

  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedActivity   VerifiedActivity @relation(fields: [verifiedActivityId], references: [id], onDelete: Cascade)

  @@unique([studentId, verifiedActivityId, periodKey], name: "studentId_verifiedActivityId_periodKey")
  @@index([studentId, category, periodKey])
  @@map("points_ledger")
}

model SyncHistory {
  id                   String    @id @default(cuid())
  studentId            String
  sourcePlatform       String
  status               String    // SUCCESS, FAILED, RATE_LIMITED, NO_PROFILE
  lastAttemptAt        DateTime  @default(now())
  lastSuccessfulSyncAt DateTime?
  recordsProcessed     Int       @default(0)
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime  @default(now())

  student              User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, sourcePlatform])
  @@map("sync_history")
}

model LeaderboardSnapshot {
  id             String    @id @default(cuid())
  studentId      String
  department     String?
  year           Int?
  section        String?
  college        String?
  periodType     String    // WEEKLY, MONTHLY, SEMESTER, ALL_TIME
  periodKey      String    // e.g. 2026-W42, 2026-M10, 2026-S2, ALL_TIME
  codingScore    Float     @default(0.0)
  hackathonScore Float     @default(0.0)
  internshipScore Float    @default(0.0)
  consistencyScore Float   @default(0.0)
  totalScore     Float     @default(0.0)
  rank           Int       @default(0)
  previousRank   Int?
  badges         Json?     @default("[]")
  isProvisional  Boolean   @default(false)
  calculatedAt   DateTime  @default(now())

  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, periodType, periodKey], name: "studentId_periodType_periodKey")
  @@index([department, year, section, periodType, periodKey])
  @@index([studentId, periodType, periodKey])
  @@map("leaderboard_snapshots")
}



