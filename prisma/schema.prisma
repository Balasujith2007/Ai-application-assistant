// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  MENTOR
  FACULTY
  HOD
  PLACEMENT_CELL
  ADMIN
}

enum ApplicationType {
  INTERNSHIP
  JOB
  HACKATHON
  COMPETITION
  WORKSHOP
  SCHOLARSHIP
  OTHER
}

enum ApplicationStatus {
  SAVED
  INITIATED
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum OpportunityType {
  JOB
  FULL_TIME
  INTERNSHIP
  HACKATHON
  COMPETITION
  SCHOLARSHIP
  WORKSHOP
  OTHER
}

enum OpportunityMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum OpportunityRegistrationStatus {
  INITIATED
  REGISTERED
  ONGOING
  COMPLETED
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notificationPreferences Json?
  privacySettings Json?
  aiPreferences Json?

  profile              Profile?
  verifiedProfiles     VerifiedProfile[]
  resumes              Resume[]
  applications         Application[]
  tasks                Task[]
  interviews           Interview[]
  activities           Activity[]
  notifications        Notification[] @relation("UserNotifications")
  sentNotifications    Notification[] @relation("SentNotifications")
  postedOpportunities  Opportunity[]  @relation("PostedOpportunities")
  registrations        OpportunityRegistration[]
  autofillSessions     AutofillSession[]

  // Mentor-Student relationship
  mentorId      String?
  mentor        User?   @relation("StudentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students      User[]  @relation("StudentMentor")

  @@map("users")
}

// ============================================================
// VERIFIED PROFILE
// ============================================================

model VerifiedProfile {
  id                 String   @id @default(cuid())
  studentId          String
  platform           String   // GITHUB, LINKEDIN, CODOLIO
  profileUrl         String
  username           String?
  verificationStatus String   @default("UNVERIFIED") // VERIFIED, FORMAT_VERIFIED, UNVERIFIED, FAILED
  verifiedAt         DateTime @default(now())
  publicMetadata     Json?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@map("verified_profiles")
}

// ============================================================
// PROFILE
// ============================================================

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  department       String?
  year             Int?
  section          String?
  college          String?
  location         String?
  careerObjective  String?
  linkedinUrl      String?
  githubUrl        String?
  portfolioUrl     String?
  codolioUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  careerPreferences Json?
  employeeId       String?
  registerNo       String?  @unique

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  education   Education[]
  projects    Project[]
  experiences Experience[]
  skills      ProfileSkill[]

  @@map("profiles")
}

// ============================================================
// SKILL (many-to-many via ProfileSkill)
// ============================================================

model Skill {
  id       String         @id @default(cuid())
  name     String         @unique
  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  skillId   String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

// ============================================================
// EDUCATION
// ============================================================

model Education {
  id           String  @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("education")
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id           String    @id @default(cuid())
  profileId    String
  title        String
  description  String?
  technologies String[]
  githubUrl    String?
  liveUrl      String?
  startDate    DateTime?
  endDate      DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ============================================================
// EXPERIENCE
// ============================================================

model Experience {
  id               String    @id @default(cuid())
  profileId        String
  company          String
  role             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

// ============================================================
// RESUME
// ============================================================

model Resume {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  fileUrl      String
  originalName String
  mimeType     String?
  fileSize     Int?
  isActive     Boolean  @default(true)
  uploadedAt   DateTime @default(now())

  // Mentor review fields
  reviewStatus   String?   @default("PENDING_REVIEW") // PENDING_REVIEW, REVIEWED, CHANGES_REQUESTED
  reviewFeedback String?
  reviewedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

// ============================================================
// APPLICATION
// ============================================================

model Application {
  id              String            @id @default(cuid())
  userId          String
  opportunityId   String?
  companyName     String
  position        String
  applicationType ApplicationType   @default(INTERNSHIP)
  applicationUrl  String?
  location        String?
  salary          String?
  description     String?
  nextAction      String?
  resumeVersion   String?
  status          ApplicationStatus @default(SAVED)
  appliedDate     DateTime?
  deadline        DateTime?
  notes           String?
  githubUrl       String?
  codolioUrl      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@map("applications")
}

// ============================================================
// TASK
// ============================================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskCategory {
  APPLICATION
  PREPARATION
  FOLLOW_UP
  OTHER
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  category    TaskCategory @default(OTHER)
  priority    TaskPriority @default(MEDIUM)
  isCompleted Boolean      @default(false)
  deadline    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// ============================================================
// INTERVIEW
// ============================================================

enum InterviewType {
  TECHNICAL
  HR
  MANAGER
  ONLINE_ASSESSMENT
  OTHER
}

model Interview {
  id          String        @id @default(cuid())
  userId      String
  companyName String
  role        String
  type        InterviewType @default(TECHNICAL)
  date        DateTime
  time        String?
  location    String?
  prepTopics  String[]
  feedback    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

// ============================================================
// OPPORTUNITY
// ============================================================

model Opportunity {
  id                  String            @id @default(cuid())
  title               String
  organization        String
  companyName         String?
  role                String?
  type                OpportunityType   @default(JOB)
  description         String
  opportunityUrl      String?
  registrationUrl     String?
  applyUrl            String?
  location            String?
  mode                OpportunityMode   @default(ONLINE)
  salary              String?
  stipend             String?
  prize               String?
  openings            Int?
  eligibility         String?
  additionalInfo      String?
  applicationDeadline DateTime
  deadline            DateTime?
  startDate           DateTime?
  endDate             DateTime?
  minCgpa             Float?
  requiredSkills      String[]
  allowedDegrees      String[]
  allowedYears        Int[]
  postedById          String?
  postedByRole        Role?             @default(MENTOR)
  status              OpportunityStatus @default(PUBLISHED)

  // Targeting fields for HOD / Placement
  targetAudience      String?           // ALL_STUDENTS, SELECTED_STUDENTS, ALL_MENTORS, SELECTED_MENTORS, BOTH
  targetDepartment    String?
  targetYear          Int?
  targetSection       String?

  viewsCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  postedBy      User?                     @relation("PostedOpportunities", fields: [postedById], references: [id], onDelete: SetNull)
  registrations OpportunityRegistration[]
  applications  Application[]
  autofillSessions AutofillSession[]

  @@map("opportunities")
}

// ============================================================
// OPPORTUNITY REGISTRATION
// ============================================================

model OpportunityRegistration {
  id            String                        @id @default(cuid())
  opportunityId String
  studentId     String
  status        OpportunityRegistrationStatus @default(INITIATED)
  notes         String?
  outcome       String?                       // Participated, Finalist, Winner, Runner-up, Selected, Completed, Other
  role          String?                       // Role or Position
  certificateUrl String?
  initiatedAt   DateTime                      @default(now())
  appliedAt     DateTime?
  registeredAt  DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime                      @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, studentId])
  @@map("opportunity_registrations")
}

// ============================================================
// ACTIVITY
// ============================================================

model Activity {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String // e.g., "APPLICATION_ADDED", "INTERVIEW_SCHEDULED"
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id                String   @id @default(cuid())
  userId            String
  senderId          String?
  type              String?  // OPPORTUNITY_POSTED, OPPORTUNITY_REGISTERED, REGISTRATION_STATUS_CHANGED, etc.
  title             String
  message           String
  relatedEntityId   String?
  relatedEntityType String?
  isRead            Boolean  @default(false)
  link              String?
  createdAt         DateTime @default(now())

  user   User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ============================================================
// AUTOFILL SESSION
// ============================================================

model AutofillSession {
  id             String   @id @default(cuid())
  studentId      String
  opportunityId  String
  sessionToken   String   @unique
  status         String   @default("CREATED") // CREATED, OPENED, FILLING, COMPLETED, EXPIRED
  fieldsDetected Int      @default(0)
  fieldsFilled   Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("autofill_sessions")
}
