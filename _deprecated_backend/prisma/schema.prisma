// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  MENTOR
  FACULTY
  HOD
  PLACEMENT_CELL
  ADMIN
}

enum ApplicationType {
  INTERNSHIP
  JOB
  HACKATHON
  OTHER
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  resumes       Resume[]
  applications  Application[]
  tasks         Task[]
  interviews    Interview[]
  activities    Activity[]
  notifications Notification[]

  @@map("users")
}

// ============================================================
// PROFILE
// ============================================================

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  department       String?
  year             Int?
  section          String?
  college          String?
  location         String?
  careerObjective  String?
  linkedinUrl      String?
  githubUrl        String?
  portfolioUrl     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  careerPreferences Json?
  employeeId       String?
  registerNo       String?  @unique

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  education   Education[]
  projects    Project[]
  experiences Experience[]
  skills      ProfileSkill[]

  @@map("profiles")
}

// ============================================================
// SKILL (many-to-many via ProfileSkill)
// ============================================================

model Skill {
  id       String         @id @default(cuid())
  name     String         @unique
  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  skillId   String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

// ============================================================
// EDUCATION
// ============================================================

model Education {
  id           String  @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("education")
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id           String    @id @default(cuid())
  profileId    String
  title        String
  description  String?
  technologies String[]
  githubUrl    String?
  liveUrl      String?
  startDate    DateTime?
  endDate      DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ============================================================
// EXPERIENCE
// ============================================================

model Experience {
  id               String    @id @default(cuid())
  profileId        String
  company          String
  role             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

// ============================================================
// RESUME
// ============================================================

model Resume {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  fileUrl      String
  originalName String
  mimeType     String?
  fileSize     Int?
  isActive     Boolean  @default(true)
  uploadedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

// ============================================================
// APPLICATION
// ============================================================

model Application {
  id              String            @id @default(cuid())
  userId          String
  companyName     String
  position        String
  applicationType ApplicationType   @default(INTERNSHIP)
  applicationUrl  String?
  location        String?
  salary          String?
  description     String?
  nextAction      String?
  resumeVersion   String?
  status          ApplicationStatus @default(SAVED)
  appliedDate     DateTime?
  deadline        DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("applications")
}

// ============================================================
// TASK
// ============================================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskCategory {
  APPLICATION
  PREPARATION
  FOLLOW_UP
  OTHER
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  category    TaskCategory @default(OTHER)
  priority    TaskPriority @default(MEDIUM)
  isCompleted Boolean      @default(false)
  deadline    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// ============================================================
// INTERVIEW
// ============================================================

enum InterviewType {
  TECHNICAL
  HR
  MANAGER
  ONLINE_ASSESSMENT
  OTHER
}

model Interview {
  id          String        @id @default(cuid())
  userId      String
  companyName String
  role        String
  type        InterviewType @default(TECHNICAL)
  date        DateTime
  time        String?
  location    String?
  prepTopics  String[]
  feedback    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

// ============================================================
// OPPORTUNITY
// ============================================================

enum OpportunityType {
  INTERNSHIP
  FULL_TIME
  HACKATHON
}

model Opportunity {
  id             String          @id @default(cuid())
  companyName    String
  role           String
  type           OpportunityType @default(FULL_TIME)
  location       String?
  salary         String?
  description    String
  applyUrl       String
  deadline       DateTime
  minCgpa        Float?
  requiredSkills String[]
  allowedDegrees String[]
  allowedYears   Int[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("opportunities")
}

// ============================================================
// ACTIVITY
// ============================================================

model Activity {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String // e.g., "APPLICATION_ADDED", "INTERVIEW_SCHEDULED"
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
