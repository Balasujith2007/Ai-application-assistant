# ATLYX Environment Configuration Template
# CRITICAL: Copy this file to .env and fill in actual values
# NEVER commit .env or .env.local to version control
# Ensure .env is listed in .gitignore

# ============================================================
# CRITICAL SECURITY SECRETS
# ============================================================

# JWT Secret for authentication tokens
# REQUIREMENT: Strong, randomly generated secret (minimum 32 characters)
# GENERATE: openssl rand -base64 32
# SECURITY: Never share, rotate regularly (quarterly recommended)
JWT_SECRET=your-strong-random-jwt-secret-minimum-32-chars

# JWT token expiration time
# Default: 7d (7 days)
# OPTIONS: 1h, 6h, 12h, 1d, 7d, 30d
JWT_EXPIRES_IN=7d

# Cron job authentication secret
# REQUIREMENT: Strong random secret for scheduled job authentication
# GENERATE: openssl rand -base64 32
# SECURITY: Used to authenticate weekly reward distribution cron
CRON_SECRET=your-strong-random-cron-secret-minimum-32-chars

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# PostgreSQL database connection string
# FORMAT: postgresql://user:password@host:port/database
# EXAMPLE: postgresql://user:password@ep-xxx.aws.neon.tech/neondb
# SECURITY: Use connection pooling for production
DATABASE_URL=postgresql://user:password@host:port/database

# Database connection pool configuration
# DEFAULT: 75
# PRODUCTION: Adjust based on serverless instance count
DB_POOL_MAX=75

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Application timezone for consistent date/time operations
# DEFAULT: Asia/Kolkata
# OPTIONS: Any IANA timezone identifier
APP_TIMEZONE=Asia/Kolkata

# Application base URL
# PRODUCTION: https://your-domain.com
# DEVELOPMENT: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base URL
# DEFAULT: /api
# PRODUCTION: https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=/api

# Node environment
# OPTIONS: development, production, test
NODE_ENV=development

# ============================================================
# CLOUDINARY CONFIGURATION (Image Upload)
# ============================================================

# Cloudinary cloud name
# GET FROM: Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API key
# GET FROM: Cloudinary dashboard
CLOUDINARY_API_KEY=your-api-key

# Cloudinary API secret
# GET FROM: Cloudinary dashboard
# SECURITY: Never commit, rotate if compromised
CLOUDINARY_API_SECRET=your-api-secret

# Cloudinary upload folder
# DEFAULT: careerai/profile-photos
CLOUDINARY_FOLDER=careerai/profile-photos

# ============================================================
# EMAIL SERVICE CONFIGURATION (Notifications)
# ============================================================

# Email service provider
# OPTIONS: gmail, sendgrid, ses, mailgun
EMAIL_SERVICE=gmail

# SMTP host
# EXAMPLE: smtp.gmail.com
SMTP_HOST=smtp.gmail.com

# SMTP port
# DEFAULT: 587 (TLS)
SMTP_PORT=587

# SMTP username
SMTP_USER=your-email@example.com

# SMTP password or app-specific password
# SECURITY: Use app-specific passwords for Gmail
SMTP_PASSWORD=your-app-specific-password

# Email from address
EMAIL_FROM=noreply@your-domain.com

# Email from name
EMAIL_FROM_NAME=ATLYX

# ============================================================
# WHATSAPP CONFIGURATION (Optional)
# ============================================================

# Twilio Account SID
# GET FROM: Twilio console
TWILIO_ACCOUNT_SID=your-twilio-account-sid

# Twilio Auth Token
# GET FROM: Twilio console
# SECURITY: Never commit, rotate if compromised
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Twilio WhatsApp number
# FORMAT: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================================
# CORS CONFIGURATION
# ============================================================

# Allowed extension IDs for CORS
# FORMAT: Comma-separated list of extension IDs
# EXAMPLE: abcdefghijklmnopqrstuvwxyz,1234567890abcdef
# SECURITY: Only whitelist trusted extensions
ALLOWED_EXTENSION_IDS=extension-id-1,extension-id-2

# Allowed origins for API access
# FORMAT: Comma-separated list of origins
# EXAMPLE: https://your-domain.com,https://app.your-domain.com
# SECURITY: Never use wildcard (*) in production
ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# ============================================================
# OAUTH CONFIGURATION (Google Auth)
# ============================================================

# Google OAuth Client ID
# GET FROM: Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id

# Google OAuth Client Secret
# GET FROM: Google Cloud Console
# SECURITY: Never commit
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth callback URL
# FORMAT: https://your-domain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================================================
# RATE LIMITING CONFIGURATION
# ============================================================

# Rate limit storage (Redis or in-memory)
# OPTIONS: redis, memory
# PRODUCTION: Use Redis for distributed deployments
RATE_LIMIT_STORAGE=memory

# Redis connection URL (if using Redis)
# FORMAT: redis://host:port
REDIS_URL=redis://localhost:6379

# Auth endpoints rate limit (requests per minute)
# DEFAULT: 5
RATE_LIMIT_AUTH_PER_MINUTE=5

# API endpoints rate limit (requests per minute)
# DEFAULT: 100
RATE_LIMIT_API_PER_MINUTE=100

# Sensitive operations rate limit (requests per second)
# DEFAULT: 1
RATE_LIMIT_SENSITIVE_PER_SECOND=1

# ============================================================
# MONITORING & LOGGING (Optional)
# ============================================================

# Sentry DSN for error tracking
# GET FROM: Sentry dashboard
# OPTIONAL: Leave empty to disable
SENTRY_DSN=

# Log level
# OPTIONS: error, warn, info, debug
LOG_LEVEL=info

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable/disable features
# OPTIONS: true, false
ENABLE_WHATSAPP=false
ENABLE_EMAIL_SYNC=false
ENABLE_AUTO_FILL_AGENT=true
ENABLE_AI_RESUME_ANALYSIS=true

# ============================================================
# INSTRUCTIONS
# ============================================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Fill in all REQUIRED values:
#    - JWT_SECRET (CRITICAL)
#    - CRON_SECRET (CRITICAL)
#    - DATABASE_URL (CRITICAL)
#    - EMAIL configuration (if using email notifications)

# 3. OPTIONAL values can be left empty or use defaults

# 4. Generate strong secrets:
#    openssl rand -base64 32

# 5. Verify .env is in .gitignore:
#    echo ".env" >> .gitignore
#    echo ".env.local" >> .gitignore

# 6. Test configuration:
#    npm run dev

# 7. Never commit .env or expose secrets in logs
